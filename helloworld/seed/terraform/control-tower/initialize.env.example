# Learning Sandbox: Day-0 Control Tower bootstrap settings
# Copy to initialize.env and fill in values:  cp initialize.env.example initialize.env
# Every key is also exported to Terraform as a lowercase TF_VAR_ copy (e.g. ORG_ID -> TF_VAR_org_id).
# See helloworld/specs/day0-bootstrap-spec.md section 3 for what each key means.

# ---- admin settings ----

# Project that gcloud/Terraform API calls are billed and rate-limited against (not where resources are created).
# Must have Resource Manager, Service Usage, Cloud Billing and Cloud Storage APIs enabled.
QUOTA_PROJECT=

# Organization and identity
ORG_ID=
DIRECTORY_CUSTOMER_ID=
DOMAIN=
IT_ADMINS_GROUP=

# Billing account linked to the Control Tower project (admin needs Billing User on it)
BILLING_ACCOUNT_ID=

# Control Tower folder
CT_FOLDER_NAME="Control Tower"
CT_FOLDER_PARENT=organizations/<ORG_ID>
# Empty = create CT_FOLDER_NAME under CT_FOLDER_PARENT. Set = use that existing folder.
CT_FOLDER_ID=

# Control Tower project (globally unique, cannot be changed once created)
CT_PROJECT_ID=lsb-control-tower
REGION=asia-southeast1

# Platform resources
TF_STATE_BUCKET=lsb-control-tower-bucket
FIRESTORE_DATABASE=lsb-control-tower-db

# ---- generated by run.sh (do not edit) ----
