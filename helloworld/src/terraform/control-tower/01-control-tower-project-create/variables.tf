# Values come from initialize.env as TF_VAR_<lowercase key> (exported by initialize.sh).

variable "org_id" {
  description = "Numeric GCP organization ID (ORG_ID)."
  type        = string
}

variable "billing_account_id" {
  description = "Billing account linked to the Control Tower project (BILLING_ACCOUNT_ID)."
  type        = string
}

variable "ct_folder_name" {
  description = "Display name of the Control Tower folder, used only when the folder is created (CT_FOLDER_NAME)."
  type        = string
}

variable "ct_folder_parent" {
  description = "Parent of the Control Tower folder: organizations/<id> or folders/<id> (CT_FOLDER_PARENT)."
  type        = string

  validation {
    condition     = can(regex("^(organizations|folders)/[0-9]+$", var.ct_folder_parent))
    error_message = "CT_FOLDER_PARENT must look like organizations/<number> or folders/<number>."
  }
}

variable "ct_folder_id" {
  description = "Existing folder ID to use (CT_FOLDER_ID). Empty = create the folder."
  type        = string
  default     = ""
}

variable "ct_folder_managed" {
  description = "Generated by run.sh: true when this operation created (and keeps managing) the folder (CT_FOLDER_MANAGED)."
  type        = bool
  default     = false
}

variable "ct_project_id" {
  description = "Globally unique Control Tower project ID (CT_PROJECT_ID)."
  type        = string

  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{4,28}[a-z0-9]$", var.ct_project_id))
    error_message = "CT_PROJECT_ID must be 6-30 characters: lowercase letters, digits, hyphens; start with a letter; not end with a hyphen."
  }
}

variable "region" {
  description = "Default region for regional resources (REGION)."
  type        = string
}

variable "tf_state_bucket" {
  description = "Name of the bucket that holds all Terraform state and runner backups (TF_STATE_BUCKET)."
  type        = string
}

variable "billing_labels" {
  description = "Billing labels from initialize.env LABEL_* keys (built by initialize.sh). Applied as provider default_labels."
  type        = map(string)
  default     = {}

  validation {
    condition = alltrue([
      for k, v in var.billing_labels :
      can(regex("^[a-z][a-z0-9_-]{0,62}$", k)) && can(regex("^[a-z0-9_-]{0,63}$", v))
    ])
    error_message = "Billing label keys must start with a lowercase letter; keys and values may use lowercase letters, digits, '-' and '_' (max 63 characters)."
  }
}
