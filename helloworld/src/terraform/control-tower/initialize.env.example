# Learning Sandbox: Day-0 Control Tower bootstrap settings
# Copy to initialize.env and fill in values:  cp initialize.env.example initialize.env
# Every key is also exported to Terraform as a lowercase TF_VAR_ copy (e.g. ORG_ID -> TF_VAR_org_id).
# See helloworld/specs/day0-bootstrap-spec.md section 3 for what each key means.

# ---- admin settings ----

# Project that gcloud/Terraform API calls are billed and rate-limited against (not where resources are created).
# Must have Resource Manager, Service Usage, Cloud Billing and Cloud Storage APIs enabled.
QUOTA_PROJECT=

# Organization and identity
ORG_ID=
DIRECTORY_CUSTOMER_ID=
DOMAIN=

# Playground service groups (created by PlaygroundGroupsCreate as locked security groups).
# IT Admins configure Playground Folders and are nested in BU Admins; BU Admins configure playgrounds.
IT_ADMINS_GROUP=grp-lsb-it-admins@<DOMAIN>
BU_ADMINS_GROUP=grp-lsb-bu-admins@<DOMAIN>
# Initial IT Admins (comma-separated user emails), added once; later changes go through the platform.
IT_ADMINS_INITIAL_MEMBERS=

# Billing account linked to the Control Tower project (admin needs Billing User on it)
BILLING_ACCOUNT_ID=

# Control Tower folder
CT_FOLDER_NAME="Control Tower"
# Where the Control Tower folder is created (must be ACTIVE):
#   organizations/<ORG_ID>  = directly under the org
#   folders/<FOLDER_ID>     = inside an existing folder, e.g. folders/600433119916 ("University Sandbox")
CT_FOLDER_PARENT=organizations/<ORG_ID>
# CT_FOLDER_PARENT=folders/<FOLDER_ID>
# Empty = create CT_FOLDER_NAME under CT_FOLDER_PARENT. Set = use that existing folder.
CT_FOLDER_ID=

# Control Tower project (globally unique across all of GCP, never reusable once deleted).
# ORG_SUFFIX is computed by initialize.sh: first 3 hex chars of sha256(ORG_ID), e.g. lsb-control-tower-e26.
CT_PROJECT_ID=lsb-control-tower-${ORG_SUFFIX}
REGION=asia-southeast1

# Platform resources
# Bucket names are global too: derived from the project ID, e.g. lsb-control-tower-e26-bucket
TF_STATE_BUCKET=${CT_PROJECT_ID}-bucket
FIRESTORE_DATABASE=lsb-control-tower-db

# Billing labels: every LABEL_<NAME> key becomes label <name> (lowercase, "_" -> "-") on the
# Control Tower project (project labels attribute all its costs in billing). Values: lowercase letters,
# digits, "-" and "_", max 63 characters. Later reused for school-specific categorization.
LABEL_COST_CENTER_BU=central-it
LABEL_COST_CENTER=lsb-control-tower
LABEL_CATEGORY=lsb-control-tower
LABEL_SUBCATEGORY=lsb-control-tower

# ---- generated by run.sh (do not edit) ----
