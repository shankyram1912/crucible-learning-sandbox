---
import { BASE, OWNER_REPO } from '../pages-map';

const { data } = Astro.locals.starlightRoute.entry;
const isSplash = data.template === 'splash';
const { title = data.title, tagline } = data.hero || {};
---

{
  isSplash ? (
    <section class="crucible-launch not-content" id="crucible-launch" data-active-stage="0" aria-label="Crucible Platform Overview">
      <div class="crucible-launch-grid">
        <div class="crucible-launch-copy">
          <div class="crucible-eyebrow">Crucible &middot; Learning Sandbox Control Tower</div>

          <h1 id="_top" data-page-title class="crucible-title">
            Govern once.<br />
            <span>Self-serve playgrounds and workspaces.</span>
          </h1>

          {tagline && <p class="crucible-sub">{tagline}</p>}

          <div class="crucible-cta">
            <a class="c-btn c-btn-primary" href={`${BASE}/brs/master/`}>
              Conceptual Architecture &rarr;
            </a>
            <a class="c-btn c-btn-secondary" href={`${BASE}/tdd/master/`}>
              Specifications
            </a>
            <a class="c-btn c-btn-secondary" href={`${BASE}/deploy/control-tower/`}>
              Deployment &amp; Guides
            </a>
            <a class="c-btn c-btn-minimal" href={`https://github.com/${OWNER_REPO}`} target="_blank" rel="noopener">
              GitHub &#8599;
            </a>
          </div>

          <div class="crucible-stages" role="region" aria-label="How Crucible works from IT governance to AI applications">
            <div class="c-stage-tabs" role="tablist">
              <button type="button" class="c-stage-tab is-active" id="c-tab-0" role="tab" aria-selected="true" aria-controls="c-pane-0" data-cstage="0">
                <span class="c-stage-bar"><i class="c-stage-progress"></i></span>
                <span class="c-stage-idx">01</span>
                <span class="c-stage-name">Playground Folders</span>
              </button>
              <button type="button" class="c-stage-tab" id="c-tab-1" role="tab" aria-selected="false" aria-controls="c-pane-1" data-cstage="1">
                <span class="c-stage-bar"><i class="c-stage-progress"></i></span>
                <span class="c-stage-idx">02</span>
                <span class="c-stage-name">Playgrounds</span>
              </button>
              <button type="button" class="c-stage-tab" id="c-tab-2" role="tab" aria-selected="false" aria-controls="c-pane-2" data-cstage="2">
                <span class="c-stage-bar"><i class="c-stage-progress"></i></span>
                <span class="c-stage-idx">03</span>
                <span class="c-stage-name">Workspaces</span>
              </button>
              <button type="button" class="c-stage-tab" id="c-tab-3" role="tab" aria-selected="false" aria-controls="c-pane-3" data-cstage="3">
                <span class="c-stage-bar"><i class="c-stage-progress"></i></span>
                <span class="c-stage-idx">04</span>
                <span class="c-stage-name">AI Apps</span>
              </button>
            </div>

            <div class="c-stage-panes">
              <div class="c-stage-pane is-active" id="c-pane-0" role="tabpanel" aria-labelledby="c-tab-0" data-cstage-pane="0">
                <h3>1. IT Admins set up catalogs and Playground Folders</h3>
                <p>
                  IT Admins maintain the versioned service catalog, playground templates, and tag catalog, and create Playground Folders under existing org folders with an immutable billing account, required folder budget, IT cost tags, BU Admin group, and guardrails.
                </p>
                <span class="c-stage-code">03 IT cost tags: cost-center-bu &middot; cost-center-code &middot; cost-category</span>
              </div>

              <div class="c-stage-pane" id="c-pane-1" role="tabpanel" aria-labelledby="c-tab-1" data-cstage-pane="1">
                <h3>2. BU Admins create Playgrounds from a template</h3>
                <p>
                  Inside a Playground Folder, BU Admins pick a template&rsquo;s <code>current</code> version, enter expected students, add BU tags, set the required playground budget and optional shard budgets, map user groups, and create project shards with tags copied as labels.
                </p>
                <span class="c-stage-code">expected students &divide; max students per project</span>
              </div>

              <div class="c-stage-pane" id="c-pane-2" role="tabpanel" aria-labelledby="c-tab-2" data-cstage-pane="2">
                <h3>3. Users initialize a workspace and create app containers</h3>
                <p>
                  On first entry into an active playground, each Student or Designated User is placed in a shard with free capacity and initializes mandatory singleton resources once, unlocking app containers within per-user allowances (<code>min..max</code>).
                </p>
                <span class="c-stage-code">sa-&lt;user&gt; &middot; bkt-&lt;project&gt;-&lt;user&gt; &middot; db_&lt;user&gt; &middot; app-&lt;name&gt;</span>
              </div>

              <div class="c-stage-pane" id="c-pane-3" role="tabpanel" aria-labelledby="c-tab-3" data-cstage-pane="3">
                <h3>4. Users run AI applications inside app containers</h3>
                <p>
                  Inside an app container (such as <code>app-lab1</code>), Cloud Run services running as <code>sa-&lt;user&gt;</code> call Gemini (Vertex AI), Vertex AI Search, Cloud SQL schemas, and Cloud Storage folders &mdash; with usage rights only in Cloud Console and Antigravity IDE.
                </p>
                <span class="c-stage-code">run-&lt;user&gt;-&lt;app&gt;-&lt;svc&gt; &middot; Gemini (Vertex AI) &middot; Vertex AI Search</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Hybrid 60fps Canvas2D + Precision SVG Orbital / Agentic AI Instrument -->
        <div class="crucible-dial-wrap">
          <div class="crucible-dial-header">
            <span class="c-dial-step" id="c-dial-step">01 / 04 &middot; IT ADMIN</span>
            <span class="c-dial-status" id="c-dial-status">Catalogs &amp; Playground Folder Governance</span>
          </div>

          <div class="crucible-dial-stage" id="crucible-dial-stage">
            <!-- 60fps Canvas2D layer: astrolabe ticks, luminous comet trails, radial tag-to-label streams & Bézier AI app packets -->
            <canvas id="crucible-dial-canvas" class="crucible-dial-canvas" aria-hidden="true"></canvas>

            <!-- Crisp Vector SVG layer: rings & architectural pills inside strict [30..530] safe bounds -->
            <svg
              class="crucible-dial-svg"
              viewBox="0 0 560 560"
              role="img"
              aria-label="Concentric architecture ring from IT Admin Playground Folder to BU Admin Playground Shards, Student Workspace, and running AI Application"
            >
              <!-- ============================================================
                   RING 01 (OUTER, R=214): IT ADMIN — PLAYGROUND FOLDER
                   ============================================================ -->
              <g class="c-ring-layer c-ring-0" data-ring-click="0">
                <circle class="c-ring-hit" cx="280" cy="280" r="214" />
                <circle class="c-ring-track c-track-blue" cx="280" cy="280" r="214" />

                <!-- Top: Playground Folder -->
                <g class="c-node-pill c-pill-blue" transform="translate(280, 66)">
                  <rect x="-86" y="-14" width="172" height="28" rx="14" />
                  <circle cx="-69" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">Playground Folder</text>
                </g>

                <!-- Top-Right: 03 IT Cost Tags (safe x: 446 +- 74 = [372..520]) -->
                <g class="c-node-pill c-pill-blue" transform="translate(446, 162)">
                  <rect x="-74" y="-14" width="148" height="28" rx="14" />
                  <text x="0" y="4" text-anchor="middle">
                    <tspan class="c-num-blue">03</tspan> IT Cost Tags
                  </text>
                </g>

                <!-- Bottom-Right: Folder Budget (safe x: 446 +- 68 = [378..514]) -->
                <g class="c-node-pill c-pill-blue" transform="translate(446, 398)">
                  <rect x="-68" y="-14" width="136" height="28" rx="14" />
                  <circle cx="-52" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">Folder Budget</text>
                </g>

                <!-- Bottom-Left: Guardrails (safe x: 114 +- 62 = [52..176]) -->
                <g class="c-node-pill c-pill-blue" transform="translate(114, 398)">
                  <rect x="-62" y="-14" width="124" height="28" rx="14" />
                  <circle cx="-46" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">Guardrails</text>
                </g>

                <!-- Top-Left: BU Admin Group (safe x: 114 +- 74 = [40..188]) -->
                <g class="c-node-pill c-pill-blue" transform="translate(114, 162)">
                  <rect x="-74" y="-14" width="148" height="28" rx="14" />
                  <circle cx="-58" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">BU Admin Group</text>
                </g>

                <!-- Bottom: Billing Account -->
                <g class="c-node-pill c-pill-blue" transform="translate(280, 494)">
                  <rect x="-74" y="-14" width="148" height="28" rx="14" />
                  <circle cx="-58" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">Billing Account</text>
                </g>
              </g>

              <!-- ============================================================
                   RING 02 (MIDDLE, R=152): BU ADMIN — PLAYGROUND & SHARDS
                   ============================================================ -->
              <g class="c-ring-layer c-ring-1" data-ring-click="1">
                <circle class="c-ring-hit" cx="280" cy="280" r="152" />
                <!-- 4 Segmented Project Shard Arcs around R=152 (circumference = 955) -->
                <circle
                  class="c-shard-arc"
                  cx="280"
                  cy="280"
                  r="152"
                  stroke-dasharray="212 26.75 212 26.75 212 26.75 212 26.75"
                  transform="rotate(-76 280 280)"
                />

                <!-- 4 Project Shard Badges -->
                <g class="c-node-pill c-pill-green" transform="translate(386, 174)">
                  <rect x="-50" y="-13" width="100" height="26" rx="13" />
                  <circle cx="-35" cy="0" r="3.6" class="c-dot-green" />
                  <text x="6" y="4" text-anchor="middle">Shard p01</text>
                </g>
                <g class="c-node-pill c-pill-green" transform="translate(386, 386)">
                  <rect x="-50" y="-13" width="100" height="26" rx="13" />
                  <circle cx="-35" cy="0" r="3.6" class="c-dot-green" />
                  <text x="6" y="4" text-anchor="middle">Shard p02</text>
                </g>
                <g class="c-node-pill c-pill-green" transform="translate(174, 386)">
                  <rect x="-50" y="-13" width="100" height="26" rx="13" />
                  <circle cx="-35" cy="0" r="3.6" class="c-dot-green" />
                  <text x="6" y="4" text-anchor="middle">Shard p03</text>
                </g>
                <g class="c-node-pill c-pill-green" transform="translate(174, 174)">
                  <rect x="-50" y="-13" width="100" height="26" rx="13" />
                  <circle cx="-35" cy="0" r="3.6" class="c-dot-green" />
                  <text x="6" y="4" text-anchor="middle">Shard p0N</text>
                </g>

                <!-- Top & Bottom Playground Metadata -->
                <g class="c-node-pill c-pill-green" transform="translate(280, 128)">
                  <rect x="-78" y="-13" width="156" height="26" rx="13" />
                  <text x="0" y="4" text-anchor="middle">Template (current)</text>
                </g>
                <g class="c-node-pill c-pill-green" transform="translate(280, 432)">
                  <rect x="-86" y="-13" width="172" height="26" rx="13" />
                  <text x="0" y="4" text-anchor="middle">
                    <tspan class="c-num-green">02</tspan> BU Tags &rarr; Labels
                  </text>
                </g>
              </g>

              <!-- ============================================================
                   RING 03 (INNER, R=94): STUDENT / USER — WORKSPACE & APPS
                   ============================================================ -->
              <g class="c-ring-layer c-ring-2" data-ring-click="2">
                <circle class="c-ring-hit" cx="280" cy="280" r="94" />
                <circle class="c-ring-track c-track-amber" cx="280" cy="280" r="94" />

                <g class="c-node-pill c-pill-amber" transform="translate(280, 186)">
                  <rect x="-54" y="-12.5" width="108" height="25" rx="12.5" />
                  <circle cx="-39" cy="0" r="3.5" class="c-dot-amber" />
                  <text x="5" y="4" text-anchor="middle">sa-&lt;user&gt;</text>
                </g>
                <g class="c-node-pill c-pill-amber" transform="translate(374, 280)">
                  <rect x="-54" y="-12.5" width="108" height="25" rx="12.5" />
                  <circle cx="-39" cy="0" r="3.5" class="c-dot-amber" />
                  <text x="5" y="4" text-anchor="middle">bkt + db_&lt;u&gt;</text>
                </g>
                <g class="c-node-pill c-pill-amber" transform="translate(280, 374)">
                  <rect x="-54" y="-12.5" width="108" height="25" rx="12.5" />
                  <circle cx="-39" cy="0" r="3.5" class="c-dot-amber" />
                  <text x="5" y="4" text-anchor="middle">app-lab1</text>
                </g>
                <g class="c-node-pill c-pill-amber" transform="translate(186, 280)">
                  <rect x="-54" y="-12.5" width="108" height="25" rx="12.5" />
                  <circle cx="-39" cy="0" r="3.5" class="c-dot-amber" />
                  <text x="5" y="4" text-anchor="middle">min..max</text>
                </g>
              </g>

              <!-- ============================================================
                   CENTER CORE (STAGES 01–03 SUMMARY BADGE)
                   ============================================================ -->
              <g class="c-center-summary" id="c-center-summary" data-ring-click="3">
                <circle class="c-summary-disc" cx="280" cy="280" r="46" />
                <text class="c-summary-kicker" id="c-summary-kicker" x="280" y="270" text-anchor="middle">GOVERNED</text>
                <text class="c-summary-main" id="c-summary-main" x="280" y="287" text-anchor="middle">Folder</text>
                <text class="c-summary-sub" id="c-summary-sub" x="280" y="302" text-anchor="middle">IT Admin</text>
              </g>

              <!-- ============================================================
                   STAGE 04 SHIFT: LIVE AI APPLICATION INSIDE app-lab1
                   (Canvas2D draws curved luminous Bézier packets behind these cards)
                   ============================================================ -->
              <g class="c-ai-app-scene" id="c-ai-app-scene">
                <circle class="c-ai-arena-ring" cx="280" cy="280" r="172" stroke-dasharray="6 8" />

                <!-- Container header pill -->
                <g transform="translate(280, 108)">
                  <rect class="c-ai-banner" x="-98" y="-14" width="196" height="28" rx="14" />
                  <text class="c-ai-banner-txt" x="0" y="4" text-anchor="middle">app-lab1 &middot; sa-&lt;user&gt;</text>
                </g>

                <!-- Satellite 0 (Top-Right): Gemini (Vertex AI) -->
                <g class="c-ai-sat c-sat-blue" data-ai-sat="0" transform="translate(392, 190)">
                  <rect x="-68" y="-23" width="136" height="46" rx="13" />
                  <text class="c-ai-sat-title" x="0" y="-4" text-anchor="middle">Gemini (Vertex AI)</text>
                  <text class="c-ai-sat-sub" x="0" y="12" text-anchor="middle">sa-&lt;user&gt; access</text>
                </g>

                <!-- Satellite 1 (Bottom-Right): Vertex AI Search -->
                <g class="c-ai-sat c-sat-red" data-ai-sat="1" transform="translate(392, 370)">
                  <rect x="-68" y="-23" width="136" height="46" rx="13" />
                  <text class="c-ai-sat-title" x="0" y="-4" text-anchor="middle">Vertex AI Search</text>
                  <text class="c-ai-sat-sub" x="0" y="12" text-anchor="middle">search-ds / app</text>
                </g>

                <!-- Satellite 2 (Bottom-Left): Cloud SQL -->
                <g class="c-ai-sat c-sat-green" data-ai-sat="2" transform="translate(168, 370)">
                  <rect x="-66" y="-23" width="132" height="46" rx="13" />
                  <text class="c-ai-sat-title" x="0" y="-4" text-anchor="middle">Cloud SQL</text>
                  <text class="c-ai-sat-sub" x="0" y="12" text-anchor="middle">db_&lt;user&gt;.schema</text>
                </g>

                <!-- Satellite 3 (Top-Left): Cloud Storage -->
                <g class="c-ai-sat c-sat-amber" data-ai-sat="3" transform="translate(168, 190)">
                  <rect x="-66" y="-23" width="132" height="46" rx="13" />
                  <text class="c-ai-sat-title" x="0" y="-4" text-anchor="middle">Cloud Storage</text>
                  <text class="c-ai-sat-sub" x="0" y="12" text-anchor="middle">apps/&lt;app&gt;/&lt;dir&gt;/</text>
                </g>

                <!-- Center Hub: Cloud Run Service -->
                <g class="c-ai-hub" transform="translate(280, 280)">
                  <circle class="c-ai-hub-core" cx="0" cy="0" r="46" />
                  <text class="c-ai-hub-kicker" x="0" y="-12" text-anchor="middle">CLOUD RUN</text>
                  <text class="c-ai-hub-title" x="0" y="5" text-anchor="middle">AI Service</text>
                  <text class="c-ai-hub-sub" x="0" y="20" text-anchor="middle">run-&lt;u&gt;-&lt;app&gt;</text>
                </g>

                <!-- Container footer caption -->
                <g transform="translate(280, 452)">
                  <rect class="c-ai-footer" x="-128" y="-13" width="256" height="26" rx="13" />
                  <text class="c-ai-footer-txt" x="0" y="4" text-anchor="middle">Cloud Console &amp; Antigravity IDE &middot; Usage only</text>
                </g>
              </g>
            </svg>
          </div>

          <!-- Interactive Ring Legend Bar -->
          <div class="crucible-dial-legend" aria-hidden="true">
            <button type="button" class="c-legend-item is-active" data-cstage-jump="0">
              <i class="c-leg-dot c-leg-blue"></i><span>Playground Folder</span>
            </button>
            <button type="button" class="c-legend-item" data-cstage-jump="1">
              <i class="c-leg-dot c-leg-green"></i><span>Playground Shards</span>
            </button>
            <button type="button" class="c-legend-item" data-cstage-jump="2">
              <i class="c-leg-dot c-leg-amber"></i><span>Workspace</span>
            </button>
            <button type="button" class="c-legend-item" data-cstage-jump="3">
              <i class="c-leg-dot c-leg-red"></i><span>AI App (app-lab1)</span>
            </button>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <div class="hero">
      <div class="sl-flex stack">
        <div class="sl-flex copy">
          <h1 id="_top" data-page-title set:html={title} />
          {tagline && <div class="tagline" set:html={tagline} />}
        </div>
      </div>
    </div>
  )
}

<script>
  function initCrucibleLifecycle() {
    const section = document.getElementById('crucible-launch');
    const canvas = document.getElementById('crucible-dial-canvas') as HTMLCanvasElement | null;
    const stageBox = document.getElementById('crucible-dial-stage');
    if (!section || !canvas || !stageBox || section.dataset.bound === '1') return;
    section.dataset.bound = '1';

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('.c-stage-tab'));
    const bars = Array.from(section.querySelectorAll<HTMLElement>('.c-stage-progress'));
    const panes = Array.from(section.querySelectorAll<HTMLElement>('[data-cstage-pane]'));
    const legendBtns = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-cstage-jump]'));
    const ringTargets = Array.from(section.querySelectorAll<SVGGElement>('[data-ring-click]'));
    const satCards = Array.from(section.querySelectorAll<SVGGElement>('[data-ai-sat]'));

    const dialStep = document.getElementById('c-dial-step');
    const dialStatus = document.getElementById('c-dial-status');
    const sumKicker = document.getElementById('c-summary-kicker');
    const sumMain = document.getElementById('c-summary-main');
    const sumSub = document.getElementById('c-summary-sub');

    const STAGE_META = [
      {
        step: '01 / 04 · IT ADMIN',
        status: 'Catalogs & Playground Folder Governance',
        kicker: 'GOVERNED',
        main: 'Folder',
        sub: 'IT Admin',
      },
      {
        step: '02 / 04 · BU ADMIN',
        status: 'Pinned Template & Project Shards',
        kicker: 'SHARDED',
        main: 'Playground',
        sub: 'BU Admin',
      },
      {
        step: '03 / 04 · STUDENT / USER',
        status: 'Singletons & App Containers (min..max)',
        kicker: 'ISOLATED',
        main: 'Workspace',
        sub: 'Student / User',
      },
      {
        step: '04 / 04 · AI PLAYGROUND TEMPLATE',
        status: 'Cloud Run (sa-<user>) ⇄ Gemini · Search · SQL · Storage',
        kicker: 'ACTIVE',
        main: 'app-lab1',
        sub: 'sa-<user>',
      },
    ];

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const STAGE_MS = 3800;

    let activeStage = 0;
    let stageStart = performance.now();
    let transitionStart = performance.now();
    let pausedUntil = 0;
    let isHovered = false;

    // Sonar shockwaves triggered on stage transitions
    interface Ripple {
      r0: number;
      r1: number;
      born: number;
      dur: number;
      rgb: string;
    }
    const ripples: Ripple[] = [];

    const COLORS = {
      blue: '66, 133, 244',
      green: '52, 168, 83',
      amber: '251, 188, 4',
      red: '234, 67, 53',
    };

    const STAGE_RGB = [COLORS.blue, COLORS.green, COLORS.amber, COLORS.blue];
    const STAGE_RADII = [214, 152, 94, 48];

    function spawnRipple(idx: number, now: number) {
      if (reduceMotion) return;
      const baseR = STAGE_RADII[idx];
      ripples.push({
        r0: Math.max(24, baseR - 28),
        r1: baseR + 34,
        born: now,
        dur: 850,
        rgb: STAGE_RGB[idx],
      });
      if (ripples.length > 5) ripples.shift();
    }

    function applyStage(idx: number, userTriggered: boolean) {
      const next = ((idx % 4) + 4) % 4;
      const now = performance.now();
      activeStage = next;
      stageStart = now;
      transitionStart = now;
      if (userTriggered) pausedUntil = now + 7000;

      section!.dataset.activeStage = String(next);
      spawnRipple(next, now);

      tabs.forEach((tab, i) => {
        const on = i === next;
        tab.classList.toggle('is-active', on);
        tab.classList.toggle('is-done', i < next);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
      });

      bars.forEach((bar, i) => {
        if (i < next) {
          bar.style.transform = 'scaleX(1)';
        } else if (i > next) {
          bar.style.transform = 'scaleX(0)';
        } else {
          bar.style.transform = reduceMotion ? 'scaleX(1)' : 'scaleX(0)';
        }
      });

      panes.forEach((p, i) => p.classList.toggle('is-active', i === next));
      legendBtns.forEach((b, i) => b.classList.toggle('is-active', i === next));

      if (next !== 3) {
        satCards.forEach((c) => c.classList.remove('is-firing'));
      }

      const meta = STAGE_META[next];
      if (dialStep) dialStep.textContent = meta.step;
      if (dialStatus) dialStatus.textContent = meta.status;
      if (sumKicker) sumKicker.textContent = meta.kicker;
      if (sumMain) sumMain.textContent = meta.main;
      if (sumSub) sumSub.textContent = meta.sub;
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => applyStage(i, true)));
    legendBtns.forEach((btn) => {
      const idx = Number(btn.dataset.cstageJump || '0');
      btn.addEventListener('click', () => applyStage(idx, true));
    });
    ringTargets.forEach((g) => {
      const idx = Number(g.dataset.ringClick || '0');
      g.addEventListener('click', () => applyStage(idx, true));
    });

    const dialWrap = section.querySelector('.crucible-dial-wrap');
    dialWrap?.addEventListener('pointerenter', () => {
      isHovered = true;
    });
    dialWrap?.addEventListener('pointerleave', () => {
      isHovered = false;
      stageStart = performance.now();
    });

    // Responsive DPI sizing mapped into the 560x560 SVG coordinate space
    let dpr = 1;
    let cssSize = 480;
    function resizeCanvas() {
      const rect = stageBox!.getBoundingClientRect();
      cssSize = Math.max(240, rect.width);
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas!.width = Math.round(cssSize * dpr);
      canvas!.height = Math.round(cssSize * dpr);
    }
    resizeCanvas();
    window.addEventListener('resize', resizeCanvas, { passive: true });

    // Helper: draw a glowing tapered comet arc on radius R
    function drawCometArc(
      c: CanvasRenderingContext2D,
      cx: number,
      cy: number,
      r: number,
      headAngle: number,
      arcLen: number,
      dir: 1 | -1,
      rgb: string,
      alpha: number,
      lineW: number,
    ) {
      const steps = 22;
      for (let s = 0; s < steps; s++) {
        const f0 = s / steps;
        const f1 = (s + 1) / steps;
        const a0 = headAngle - dir * arcLen * f1;
        const a1 = headAngle - dir * arcLen * f0;
        const segAlpha = alpha * Math.pow(1 - f0, 1.85);
        c.beginPath();
        c.arc(cx, cy, r, Math.min(a0, a1), Math.max(a0, a1));
        c.strokeStyle = `rgba(${rgb}, ${segAlpha.toFixed(3)})`;
        c.lineWidth = lineW * (0.35 + 0.65 * (1 - f0));
        c.lineCap = 'round';
        c.stroke();
      }
      // Glowing comet head dot
      const hx = cx + Math.cos(headAngle) * r;
      const hy = cy + Math.sin(headAngle) * r;
      const grad = c.createRadialGradient(hx, hy, 0, hx, hy, lineW * 3.4);
      grad.addColorStop(0, `rgba(${rgb}, ${(alpha * 0.95).toFixed(3)})`);
      grad.addColorStop(0.45, `rgba(${rgb}, ${(alpha * 0.35).toFixed(3)})`);
      grad.addColorStop(1, `rgba(${rgb}, 0)`);
      c.fillStyle = grad;
      c.beginPath();
      c.arc(hx, hy, lineW * 3.4, 0, Math.PI * 2);
      c.fill();
    }

    // Helper: quadratic Bézier point at t in [0..1]
    function quadPt(x0: number, y0: number, qx: number, qy: number, x1: number, y1: number, t: number) {
      const mt = 1 - t;
      return {
        x: mt * mt * x0 + 2 * mt * t * qx + t * t * x1,
        y: mt * mt * y0 + 2 * mt * t * qy + t * t * y1,
      };
    }

    // Helper: draw curved Bézier guide + animated glowing packet trail
    function drawBezierPacket(
      c: CanvasRenderingContext2D,
      x0: number,
      y0: number,
      qx: number,
      qy: number,
      x1: number,
      y1: number,
      t: number,
      rgb: string,
      alpha: number,
    ) {
      // Subtle curved conduit track
      c.beginPath();
      c.moveTo(x0, y0);
      c.quadraticCurveTo(qx, qy, x1, y1);
      c.strokeStyle = `rgba(${rgb}, ${(alpha * 0.22).toFixed(3)})`;
      c.lineWidth = 1.6;
      c.stroke();

      // Tapered packet trail behind head at t
      const trailLen = 0.24;
      const segs = 12;
      for (let i = 0; i < segs; i++) {
        const u0 = Math.max(0, t - (trailLen * (i + 1)) / segs);
        const u1 = Math.max(0, t - (trailLen * i) / segs);
        if (u1 <= u0) continue;
        const p0 = quadPt(x0, y0, qx, qy, x1, y1, u0);
        const p1 = quadPt(x0, y0, qx, qy, x1, y1, u1);
        const fade = Math.pow(1 - i / segs, 1.7) * alpha;
        c.beginPath();
        c.moveTo(p0.x, p0.y);
        c.lineTo(p1.x, p1.y);
        c.strokeStyle = `rgba(${rgb}, ${fade.toFixed(3)})`;
        c.lineWidth = 3.2 * (1 - (i / segs) * 0.6);
        c.lineCap = 'round';
        c.stroke();
      }

      // Packet head glow
      const head = quadPt(x0, y0, qx, qy, x1, y1, t);
      const g = c.createRadialGradient(head.x, head.y, 0, head.x, head.y, 11);
      g.addColorStop(0, `rgba(255, 255, 255, ${(alpha * 0.95).toFixed(3)})`);
      g.addColorStop(0.35, `rgba(${rgb}, ${(alpha * 0.85).toFixed(3)})`);
      g.addColorStop(1, `rgba(${rgb}, 0)`);
      c.fillStyle = g;
      c.beginPath();
      c.arc(head.x, head.y, 11, 0, Math.PI * 2);
      c.fill();
    }

    // 4 AI Satellites in 560x560 space (matching SVG coordinates)
    const AI_SATS = [
      { x: 392, y: 190, qx: 348, qy: 204, rgb: COLORS.blue },  // Gemini (Vertex AI)
      { x: 392, y: 370, qx: 356, qy: 344, rgb: COLORS.red },   // Vertex AI Search
      { x: 168, y: 370, qx: 204, qy: 344, rgb: COLORS.green }, // Cloud SQL
      { x: 168, y: 190, qx: 212, qy: 204, rgb: COLORS.amber }, // Cloud Storage
    ];

    // 6 Outer Folder Governance node angles (radians)
    const FOLDER_ANGLES = [-Math.PI / 2, -0.51, 0.51, Math.PI / 2, Math.PI - 0.51, -Math.PI + 0.51];
    // 4 Shard angles (radians)
    const SHARD_ANGLES = [-Math.PI / 4, Math.PI / 4, (3 * Math.PI) / 4, (-3 * Math.PI) / 4];

    applyStage(0, false);

    let rafId = 0;
    const t0 = performance.now();

    function renderFrame(now: number) {
      if (!document.body.contains(section)) {
        cancelAnimationFrame(rafId);
        return;
      }

      // Advance stage progress bar
      if (!reduceMotion) {
        if (isHovered || now < pausedUntil) {
          bars[activeStage].style.transform = 'scaleX(1)';
        } else {
          const elapsed = now - stageStart;
          const progress = Math.min(1, Math.max(0, elapsed / STAGE_MS));
          bars[activeStage].style.transform = `scaleX(${progress.toFixed(3)})`;
          if (elapsed >= STAGE_MS) {
            applyStage(activeStage + 1, false);
          }
        }
      }

      const sec = reduceMotion ? 0 : (now - t0) * 0.001;
      const isLight = document.documentElement.dataset.theme === 'light';
      const scale = (cssSize * dpr) / 560;

      ctx!.save();
      ctx!.clearRect(0, 0, canvas!.width, canvas!.height);
      ctx!.scale(scale, scale);

      const CX = 280;
      const CY = 280;

      // 1. Ambient radial core glow matched to active stage
      const coreRgb = STAGE_RGB[activeStage];
      const amb = ctx!.createRadialGradient(CX, CY, 12, CX, CY, 250);
      amb.addColorStop(0, `rgba(${coreRgb}, ${isLight ? 0.11 : 0.17})`);
      amb.addColorStop(0.55, `rgba(${coreRgb}, ${isLight ? 0.04 : 0.06})`);
      amb.addColorStop(1, `rgba(${coreRgb}, 0)`);
      ctx!.fillStyle = amb;
      ctx!.beginPath();
      ctx!.arc(CX, CY, 250, 0, Math.PI * 2);
      ctx!.fill();

      // 2. Rotating Precision Astrolabe Perimeter Ticks (R = 242..249)
      const tickCount = 96;
      const tickRot = sec * 0.08;
      for (let i = 0; i < tickCount; i++) {
        const a = (i / tickCount) * Math.PI * 2 + tickRot;
        const major = i % 8 === 0;
        const rIn = major ? 239 : 243;
        const rOut = 248;
        ctx!.beginPath();
        ctx!.moveTo(CX + Math.cos(a) * rIn, CY + Math.sin(a) * rIn);
        ctx!.lineTo(CX + Math.cos(a) * rOut, CY + Math.sin(a) * rOut);
        ctx!.strokeStyle = isLight
          ? `rgba(60, 64, 67, ${major ? 0.24 : 0.11})`
          : `rgba(154, 164, 178, ${major ? 0.28 : 0.11})`;
        ctx!.lineWidth = major ? 1.4 : 1;
        ctx!.stroke();
      }

      // 3. Expanding Sonar Ripples on stage switch
      for (let i = ripples.length - 1; i >= 0; i--) {
        const rp = ripples[i];
        const u = (now - rp.born) / rp.dur;
        if (u >= 1) {
          ripples.splice(i, 1);
          continue;
        }
        const ease = 1 - Math.pow(1 - u, 3);
        const rr = rp.r0 + (rp.r1 - rp.r0) * ease;
        const alpha = (1 - u) * (isLight ? 0.42 : 0.55);
        ctx!.beginPath();
        ctx!.arc(CX, CY, rr, 0, Math.PI * 2);
        ctx!.strokeStyle = `rgba(${rp.rgb}, ${alpha.toFixed(3)})`;
        ctx!.lineWidth = 2.2 * (1 - u * 0.5);
        ctx!.stroke();
      }

      // 4. Stage-specific kinetic streams
      if (activeStage === 0) {
        // Dual counter-orbiting blue comets on Outer Playground Folder Ring (R=214)
        drawCometArc(ctx!, CX, CY, 214, sec * 1.65, 1.15, 1, COLORS.blue, 0.95, 3.6);
        drawCometArc(ctx!, CX, CY, 214, sec * 1.65 + Math.PI, 0.95, 1, COLORS.blue, 0.75, 3.0);

        // Subtle radial governance pulses from center out to the 6 folder nodes
        for (let k = 0; k < FOLDER_ANGLES.length; k++) {
          const ang = FOLDER_ANGLES[k];
          const p = (sec * 0.9 + k * 0.17) % 1;
          const rCur = 52 + p * (214 - 52);
          const px = CX + Math.cos(ang) * rCur;
          const py = CY + Math.sin(ang) * rCur;
          const alpha = Math.sin(p * Math.PI) * 0.65;
          ctx!.beginPath();
          ctx!.moveTo(CX + Math.cos(ang) * 50, CY + Math.sin(ang) * 50);
          ctx!.lineTo(CX + Math.cos(ang) * 210, CY + Math.sin(ang) * 210);
          ctx!.strokeStyle = `rgba(${COLORS.blue}, 0.10)`;
          ctx!.lineWidth = 1;
          ctx!.stroke();

          ctx!.beginPath();
          ctx!.arc(px, py, 2.8, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(${COLORS.blue}, ${alpha.toFixed(3)})`;
          ctx!.fill();
        }
      } else if (activeStage === 1) {
        // Gentle outer governance frame comet + lively dual green comets on Shard Ring (R=152)
        drawCometArc(ctx!, CX, CY, 214, sec * 0.8, 0.7, 1, COLORS.blue, 0.35, 2.2);
        drawCometArc(ctx!, CX, CY, 152, -sec * 1.9, 1.05, -1, COLORS.green, 0.95, 3.8);
        drawCometArc(ctx!, CX, CY, 152, -sec * 1.9 + Math.PI, 0.85, -1, COLORS.green, 0.75, 3.2);

        // Radial tag-to-label inheritance comets streaming INWARD from Outer Ring (214) -> Shard Ring (152)
        for (let k = 0; k < SHARD_ANGLES.length; k++) {
          const ang = SHARD_ANGLES[k];
          const p = (sec * 1.35 + k * 0.25) % 1;
          const rCur = 214 - p * (214 - 152);
          const x0 = CX + Math.cos(ang) * 214;
          const y0 = CY + Math.sin(ang) * 214;
          const x1 = CX + Math.cos(ang) * 152;
          const y1 = CY + Math.sin(ang) * 152;

          ctx!.beginPath();
          ctx!.moveTo(x0, y0);
          ctx!.lineTo(x1, y1);
          ctx!.strokeStyle = `rgba(${COLORS.green}, 0.24)`;
          ctx!.lineWidth = 1.5;
          ctx!.stroke();

          const hx = CX + Math.cos(ang) * rCur;
          const hy = CY + Math.sin(ang) * rCur;
          const g = ctx!.createRadialGradient(hx, hy, 0, hx, hy, 8);
          g.addColorStop(0, `rgba(${COLORS.green}, 0.95)`);
          g.addColorStop(1, `rgba(${COLORS.green}, 0)`);
          ctx!.fillStyle = g;
          ctx!.beginPath();
          ctx!.arc(hx, hy, 8, 0, Math.PI * 2);
          ctx!.fill();
        }
      } else if (activeStage === 2) {
        // Outer & Middle quiet comets + fast golden Workspace comets on Inner Ring (R=94)
        drawCometArc(ctx!, CX, CY, 214, sec * 0.6, 0.55, 1, COLORS.blue, 0.22, 1.8);
        drawCometArc(ctx!, CX, CY, 152, -sec * 0.9, 0.65, -1, COLORS.green, 0.32, 2.2);
        drawCometArc(ctx!, CX, CY, 94, sec * 2.3, 1.2, 1, COLORS.amber, 0.95, 3.8);
        drawCometArc(ctx!, CX, CY, 94, sec * 2.3 + Math.PI, 0.9, 1, COLORS.amber, 0.8, 3.0);

        // Shard -> Workspace placement stream from Shard p01 (-45deg, R=152) into Workspace (R=94)
        for (let k = 0; k < 4; k++) {
          const ang = (k * Math.PI) / 2;
          const p = (sec * 1.5 + k * 0.25) % 1;
          const rCur = 152 - p * (152 - 94);
          const hx = CX + Math.cos(ang) * rCur;
          const hy = CY + Math.sin(ang) * rCur;

          ctx!.beginPath();
          ctx!.moveTo(CX + Math.cos(ang) * 150, CY + Math.sin(ang) * 150);
          ctx!.lineTo(CX + Math.cos(ang) * 96, CY + Math.sin(ang) * 96);
          ctx!.strokeStyle = `rgba(${COLORS.amber}, 0.22)`;
          ctx!.lineWidth = 1.4;
          ctx!.stroke();

          const g = ctx!.createRadialGradient(hx, hy, 0, hx, hy, 7);
          g.addColorStop(0, `rgba(${COLORS.amber}, 0.95)`);
          g.addColorStop(1, `rgba(${COLORS.amber}, 0)`);
          ctx!.fillStyle = g;
          ctx!.beginPath();
          ctx!.arc(hx, hy, 7, 0, Math.PI * 2);
          ctx!.fill();
        }
      } else {
        // Stage 04: Outer governed halo comet + Live Round-Trip Agentic AI Application Telemetry
        drawCometArc(ctx!, CX, CY, 222, sec * 0.75, 0.85, 1, COLORS.blue, 0.35, 2.2);
        drawCometArc(ctx!, CX, CY, 172, -sec * 1.1, 0.75, -1, COLORS.amber, 0.55, 2.4);

        // Pulsing radar aura around Cloud Run center hub
        const hubPulse = (sec * 1.2) % 1;
        ctx!.beginPath();
        ctx!.arc(CX, CY, 46 + hubPulse * 26, 0, Math.PI * 2);
        ctx!.strokeStyle = `rgba(${COLORS.blue}, ${((1 - hubPulse) * 0.5).toFixed(3)})`;
        ctx!.lineWidth = 2;
        ctx!.stroke();

        // Round-trip request & response packets to all 4 GCP AI services
        const elapsedStage = Math.max(0, now - transitionStart);
        const fadeIn = Math.min(1, elapsedStage / 260);

        AI_SATS.forEach((sat, idx) => {
          // Staggered phase per service so packets cascade rhythmically
          const cycle = (sec * 1.15 + idx * 0.25) % 1;
          // Outbound 0..0.5, Inbound 0.5..1.0
          const outbound = cycle < 0.5;
          const localT = outbound ? cycle * 2 : (cycle - 0.5) * 2;

          if (outbound) {
            drawBezierPacket(ctx!, CX, CY, sat.qx, sat.qy, sat.x, sat.y, localT, sat.rgb, 0.95 * fadeIn);
          } else {
            drawBezierPacket(ctx!, sat.x, sat.y, sat.qx, sat.qy, CX, CY, localT, sat.rgb, 0.9 * fadeIn);
          }

          // Highlight the SVG satellite card right as the packet arrives (cycle 0.38..0.66)
          const card = satCards[idx];
          if (card) {
            card.classList.toggle('is-firing', cycle > 0.36 && cycle < 0.68);
          }
        });
      }

      ctx!.restore();
      rafId = requestAnimationFrame(renderFrame);
    }

    rafId = requestAnimationFrame(renderFrame);
  }

  initCrucibleLifecycle();
  document.addEventListener('astro:page-load', initCrucibleLifecycle);
</script>
