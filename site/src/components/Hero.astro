---
import { BASE, OWNER_REPO } from '../pages-map';

const { data } = Astro.locals.starlightRoute.entry;
const isSplash = data.template === 'splash';
const { title = data.title, tagline } = data.hero || {};
---

{
  isSplash ? (
    <section class="crucible-launch not-content" id="crucible-launch" data-active-stage="0" aria-label="Crucible Platform Overview">
      <div class="crucible-launch-grid">
        <div class="crucible-launch-copy">
          <div class="crucible-eyebrow">Crucible &middot; Learning Sandbox Control Tower</div>

          <h1 id="_top" data-page-title class="crucible-title">
            Govern once.<br />
            <span>Self-serve playgrounds and workspaces.</span>
          </h1>

          {tagline && <p class="crucible-sub">{tagline}</p>}

          <div class="crucible-cta">
            <a class="c-btn c-btn-primary" href={`${BASE}/brs/master/`}>
              Conceptual Architecture &rarr;
            </a>
            <a class="c-btn c-btn-secondary" href={`${BASE}/tdd/master/`}>
              Specifications
            </a>
            <a class="c-btn c-btn-secondary" href={`${BASE}/deploy/control-tower/`}>
              Deployment &amp; Guides
            </a>
            <a class="c-btn c-btn-minimal" href={`https://github.com/${OWNER_REPO}`} target="_blank" rel="noopener">
              GitHub &#8599;
            </a>
          </div>

          <div class="crucible-stages" role="region" aria-label="How Crucible works from IT governance to AI applications">
            <div class="c-stage-tabs" role="tablist">
              <button type="button" class="c-stage-tab is-active" id="c-tab-0" role="tab" aria-selected="true" aria-controls="c-pane-0" data-cstage="0">
                <span class="c-stage-bar"><i class="c-stage-progress"></i></span>
                <span class="c-stage-idx">01</span>
                <span class="c-stage-name">Playground Folders</span>
              </button>
              <button type="button" class="c-stage-tab" id="c-tab-1" role="tab" aria-selected="false" aria-controls="c-pane-1" data-cstage="1">
                <span class="c-stage-bar"><i class="c-stage-progress"></i></span>
                <span class="c-stage-idx">02</span>
                <span class="c-stage-name">Playgrounds</span>
              </button>
              <button type="button" class="c-stage-tab" id="c-tab-2" role="tab" aria-selected="false" aria-controls="c-pane-2" data-cstage="2">
                <span class="c-stage-bar"><i class="c-stage-progress"></i></span>
                <span class="c-stage-idx">03</span>
                <span class="c-stage-name">Workspaces</span>
              </button>
              <button type="button" class="c-stage-tab" id="c-tab-3" role="tab" aria-selected="false" aria-controls="c-pane-3" data-cstage="3">
                <span class="c-stage-bar"><i class="c-stage-progress"></i></span>
                <span class="c-stage-idx">04</span>
                <span class="c-stage-name">AI Apps</span>
              </button>
            </div>

            <div class="c-stage-panes">
              <div class="c-stage-pane is-active" id="c-pane-0" role="tabpanel" aria-labelledby="c-tab-0" data-cstage-pane="0">
                <h3>1. IT Admins set up catalogs and Playground Folders</h3>
                <p>
                  IT Admins maintain the versioned service catalog, playground templates, and tag catalog, and create Playground Folders under existing org folders with an immutable billing account, required folder budget, IT cost tags, BU Admin group, and guardrails.
                </p>
                <span class="c-stage-code">cost-center-bu &middot; cost-center-code &middot; cost-category</span>
              </div>

              <div class="c-stage-pane" id="c-pane-1" role="tabpanel" aria-labelledby="c-tab-1" data-cstage-pane="1">
                <h3>2. BU Admins create Playgrounds from a template</h3>
                <p>
                  Inside a Playground Folder, BU Admins pick a template&rsquo;s <code>current</code> version, enter expected students, add BU tags, set the required playground budget and optional shard budgets, map user groups, and create project shards with tags copied as labels.
                </p>
                <span class="c-stage-code">expected students &divide; max students per project</span>
              </div>

              <div class="c-stage-pane" id="c-pane-2" role="tabpanel" aria-labelledby="c-tab-2" data-cstage-pane="2">
                <h3>3. Users initialize a workspace and create app containers</h3>
                <p>
                  On first entry into an active playground, each Student or Designated User is placed in a shard with free capacity and initializes mandatory singleton resources once, unlocking app containers within per-user allowances (<code>min..max</code>).
                </p>
                <span class="c-stage-code">sa-&lt;user&gt; &middot; bkt-&lt;project&gt;-&lt;user&gt; &middot; db_&lt;user&gt; &middot; app-&lt;name&gt;</span>
              </div>

              <div class="c-stage-pane" id="c-pane-3" role="tabpanel" aria-labelledby="c-tab-3" data-cstage-pane="3">
                <h3>4. Users run AI applications inside app containers</h3>
                <p>
                  Inside an app container (such as <code>app-lab1</code>), Cloud Run services running as <code>sa-&lt;user&gt;</code> call Gemini (Vertex AI), Vertex AI Search, Cloud SQL schemas, and Cloud Storage folders &mdash; with usage rights only in Cloud Console and Antigravity IDE.
                </p>
                <span class="c-stage-code">run-&lt;user&gt;-&lt;app&gt;-&lt;svc&gt; &middot; Gemini (Vertex AI) &middot; Vertex AI Search</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Contextual Circular Lifecycle -> AI Application Instrument -->
        <div class="crucible-dial-wrap">
          <div class="crucible-dial-header">
            <span class="c-dial-step" id="c-dial-step">01 / 04 &middot; IT ADMIN</span>
            <span class="c-dial-status" id="c-dial-status">Playground Folder Governance</span>
          </div>

          <div class="crucible-dial-stage" id="crucible-dial-stage">
            <svg
              class="crucible-dial-svg"
              viewBox="0 0 560 560"
              role="img"
              aria-label="Concentric architecture ring from IT Admin Playground Folder to BU Admin Playground Shards, Student Workspace, and running AI Application"
            >
              <defs>
                <radialGradient id="c-core-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#4285f4" stop-opacity="0.20" />
                  <stop offset="65%" stop-color="#34a853" stop-opacity="0.06" />
                  <stop offset="100%" stop-color="#4285f4" stop-opacity="0" />
                </radialGradient>
                <filter id="c-soft-glow" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="3" result="blur" />
                  <feMerge>
                    <feMergeNode in="blur" />
                    <feMergeNode in="SourceGraphic" />
                  </feMerge>
                </filter>
              </defs>

              <!-- Subtle radial ambient center -->
              <circle cx="280" cy="280" r="248" fill="url(#c-core-glow)" />

              <!-- Crosshair reference axes -->
              <g class="c-axes" aria-hidden="true">
                <line x1="280" y1="26" x2="280" y2="534" />
                <line x1="26" y1="280" x2="534" y2="280" />
              </g>

              <!-- ============================================================
                   RING 01 (OUTER, R=232): IT ADMIN — PLAYGROUND FOLDER
                   ============================================================ -->
              <g class="c-ring-layer c-ring-0" data-ring-click="0">
                <circle class="c-ring-hit" cx="280" cy="280" r="232" />
                <circle class="c-ring-track" cx="280" cy="280" r="232" />
                <circle class="c-ring-orbit c-orbit-blue" cx="280" cy="280" r="232" stroke-dasharray="110 1350" />

                <!-- Radial tag inheritance lines inward when transitioning to shards -->
                <g class="c-inherit-spokes">
                  <line x1="280" y1="48" x2="280" y2="108" />
                  <line x1="512" y1="280" x2="452" y2="280" />
                  <line x1="280" y1="512" x2="280" y2="452" />
                  <line x1="48" y1="280" x2="108" y2="280" />
                </g>

                <!-- 4 Perimeter Anchor Nodes on Outer Ring -->
                <!-- Top: Playground Folder + Billing Account -->
                <g class="c-node-pill" transform="translate(280, 48)">
                  <rect x="-92" y="-15" width="184" height="30" rx="15" />
                  <circle cx="-74" cy="0" r="4.5" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">Playground Folder</text>
                </g>

                <!-- Right: IT Cost Tags -->
                <g class="c-node-pill" transform="translate(466, 152)">
                  <rect x="-72" y="-14" width="144" height="28" rx="14" />
                  <circle cx="-56" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">IT Cost Tags (3)</text>
                </g>

                <!-- Bottom-Right: Folder Budget -->
                <g class="c-node-pill" transform="translate(462, 412)">
                  <rect x="-70" y="-14" width="140" height="28" rx="14" />
                  <circle cx="-54" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">Folder Budget</text>
                </g>

                <!-- Bottom-Left: Guardrails -->
                <g class="c-node-pill" transform="translate(98, 412)">
                  <rect x="-64" y="-14" width="128" height="28" rx="14" />
                  <circle cx="-48" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">Guardrails</text>
                </g>

                <!-- Top-Left: BU Admin Group + Billing -->
                <g class="c-node-pill" transform="translate(96, 152)">
                  <rect x="-76" y="-14" width="152" height="28" rx="14" />
                  <circle cx="-60" cy="0" r="4" class="c-dot-blue" />
                  <text x="6" y="4" text-anchor="middle">BU Admin Group</text>
                </g>
              </g>

              <!-- ============================================================
                   RING 02 (MIDDLE, R=170): BU ADMIN — PLAYGROUND & SHARDS
                   ============================================================ -->
              <g class="c-ring-layer c-ring-1" data-ring-click="1">
                <circle class="c-ring-hit" cx="280" cy="280" r="170" />
                <!-- 4 Segmented Project Shard Arcs around R=170 (circumference = 1068) -->
                <circle
                  class="c-shard-arc"
                  cx="280"
                  cy="280"
                  r="170"
                  stroke-dasharray="238 29 238 29 238 29 238 29"
                  transform="rotate(-76 280 280)"
                />
                <circle class="c-ring-orbit c-orbit-green" cx="280" cy="280" r="170" stroke-dasharray="84 984" />

                <!-- 4 Project Shard Badges on Middle Ring -->
                <g class="c-node-pill c-pill-shard" transform="translate(398, 158)">
                  <rect x="-52" y="-13" width="104" height="26" rx="13" />
                  <circle cx="-37" cy="0" r="3.8" class="c-dot-green" />
                  <text x="6" y="4" text-anchor="middle">Shard p01</text>
                </g>
                <g class="c-node-pill c-pill-shard" transform="translate(398, 402)">
                  <rect x="-52" y="-13" width="104" height="26" rx="13" />
                  <circle cx="-37" cy="0" r="3.8" class="c-dot-green" />
                  <text x="6" y="4" text-anchor="middle">Shard p02</text>
                </g>
                <g class="c-node-pill c-pill-shard" transform="translate(162, 402)">
                  <rect x="-52" y="-13" width="104" height="26" rx="13" />
                  <circle cx="-37" cy="0" r="3.8" class="c-dot-green" />
                  <text x="6" y="4" text-anchor="middle">Shard p03</text>
                </g>
                <g class="c-node-pill c-pill-shard" transform="translate(162, 158)">
                  <rect x="-52" y="-13" width="104" height="26" rx="13" />
                  <circle cx="-37" cy="0" r="3.8" class="c-dot-green" />
                  <text x="6" y="4" text-anchor="middle">Shard p0N</text>
                </g>

                <!-- Top & Bottom Playground Metadata -->
                <g class="c-node-pill c-pill-meta" transform="translate(280, 110)">
                  <rect x="-82" y="-13" width="164" height="26" rx="13" />
                  <text x="0" y="4" text-anchor="middle">Template (current)</text>
                </g>
                <g class="c-node-pill c-pill-meta" transform="translate(280, 450)">
                  <rect x="-86" y="-13" width="172" height="26" rx="13" />
                  <text x="0" y="4" text-anchor="middle">Tags &rarr; Project Labels</text>
                </g>
              </g>

              <!-- ============================================================
                   RING 03 (INNER, R=108): STUDENT / USER — WORKSPACE & APPS
                   ============================================================ -->
              <g class="c-ring-layer c-ring-2" data-ring-click="2">
                <circle class="c-ring-hit" cx="280" cy="280" r="108" />
                <circle class="c-ring-track c-track-amber" cx="280" cy="280" r="108" />
                <circle class="c-ring-orbit c-orbit-amber" cx="280" cy="280" r="108" stroke-dasharray="64 615" />

                <!-- Singleton Resources & App Containers on Inner Ring -->
                <g class="c-node-pill c-pill-ws" transform="translate(280, 172)">
                  <rect x="-58" y="-13" width="116" height="26" rx="13" />
                  <circle cx="-42" cy="0" r="3.8" class="c-dot-amber" />
                  <text x="6" y="4" text-anchor="middle">sa-&lt;user&gt;</text>
                </g>
                <g class="c-node-pill c-pill-ws" transform="translate(388, 280)">
                  <rect x="-58" y="-13" width="116" height="26" rx="13" />
                  <circle cx="-42" cy="0" r="3.8" class="c-dot-amber" />
                  <text x="6" y="4" text-anchor="middle">bkt + db_&lt;u&gt;</text>
                </g>
                <g class="c-node-pill c-pill-ws" transform="translate(280, 388)">
                  <rect x="-58" y="-13" width="116" height="26" rx="13" />
                  <circle cx="-42" cy="0" r="3.8" class="c-dot-amber" />
                  <text x="6" y="4" text-anchor="middle">app-lab1</text>
                </g>
                <g class="c-node-pill c-pill-ws" transform="translate(172, 280)">
                  <rect x="-58" y="-13" width="116" height="26" rx="13" />
                  <circle cx="-42" cy="0" r="3.8" class="c-dot-amber" />
                  <text x="6" y="4" text-anchor="middle">min..max</text>
                </g>
              </g>

              <!-- ============================================================
                   CENTER CORE (STAGES 01–03 SUMMARY BADGE)
                   ============================================================ -->
              <g class="c-center-summary" id="c-center-summary" data-ring-click="3">
                <circle class="c-summary-disc" cx="280" cy="280" r="54" />
                <text class="c-summary-kicker" id="c-summary-kicker" x="280" y="269" text-anchor="middle">GOVERNED</text>
                <text class="c-summary-main" id="c-summary-main" x="280" y="288" text-anchor="middle">Folder</text>
                <text class="c-summary-sub" id="c-summary-sub" x="280" y="304" text-anchor="middle">IT Admin</text>
              </g>

              <!-- ============================================================
                   STAGE 04 SHIFT: LIVE AI APPLICATION INSIDE app-lab1
                   (Zooms forward when Stage 04 is active while rings form halo)
                   ============================================================ -->
              <g class="c-ai-app-scene" id="c-ai-app-scene">
                <!-- App Container boundary card -->
                <circle class="c-ai-arena" cx="280" cy="280" r="166" />
                <circle class="c-ai-arena-ring" cx="280" cy="280" r="166" stroke-dasharray="8 8" />

                <!-- Container header pill -->
                <g transform="translate(280, 114)">
                  <rect class="c-ai-banner" x="-96" y="-14" width="192" height="28" rx="14" />
                  <text class="c-ai-banner-txt" x="0" y="4" text-anchor="middle">app-lab1 &middot; sa-&lt;user&gt;</text>
                </g>

                <!-- Animated Request / Data-Plane Connectors from Cloud Run Hub -->
                <g class="c-ai-links" filter="url(#c-soft-glow)">
                  <!-- Hub -> Gemini (Top-Right) -->
                  <line class="c-ai-link-base" x1="280" y1="280" x2="378" y2="196" />
                  <line class="c-ai-link-pulse c-pulse-1" x1="280" y1="280" x2="378" y2="196" />

                  <!-- Hub -> Vertex AI Search (Bottom-Right) -->
                  <line class="c-ai-link-base" x1="280" y1="280" x2="382" y2="362" />
                  <line class="c-ai-link-pulse c-pulse-2" x1="280" y1="280" x2="382" y2="362" />

                  <!-- Hub -> Cloud SQL (Bottom-Left) -->
                  <line class="c-ai-link-base" x1="280" y1="280" x2="178" y2="362" />
                  <line class="c-ai-link-pulse c-pulse-3" x1="280" y1="280" x2="178" y2="362" />

                  <!-- Hub -> Cloud Storage (Top-Left) -->
                  <line class="c-ai-link-base" x1="280" y1="280" x2="182" y2="196" />
                  <line class="c-ai-link-pulse c-pulse-4" x1="280" y1="280" x2="182" y2="196" />
                </g>

                <!-- Satellite 1 (Top-Right): Gemini (Vertex AI) -->
                <g class="c-ai-sat" transform="translate(384, 192)">
                  <rect x="-66" y="-22" width="132" height="44" rx="12" />
                  <text class="c-ai-sat-title" x="0" y="-3" text-anchor="middle">Gemini (Vertex AI)</text>
                  <text class="c-ai-sat-sub" x="0" y="12" text-anchor="middle">sa-&lt;user&gt; access</text>
                </g>

                <!-- Satellite 2 (Bottom-Right): Vertex AI Search -->
                <g class="c-ai-sat" transform="translate(384, 366)">
                  <rect x="-68" y="-22" width="136" height="44" rx="12" />
                  <text class="c-ai-sat-title" x="0" y="-3" text-anchor="middle">Vertex AI Search</text>
                  <text class="c-ai-sat-sub" x="0" y="12" text-anchor="middle">search-ds / app</text>
                </g>

                <!-- Satellite 3 (Bottom-Left): Cloud SQL -->
                <g class="c-ai-sat" transform="translate(176, 366)">
                  <rect x="-66" y="-22" width="132" height="44" rx="12" />
                  <text class="c-ai-sat-title" x="0" y="-3" text-anchor="middle">Cloud SQL</text>
                  <text class="c-ai-sat-sub" x="0" y="12" text-anchor="middle">db_&lt;user&gt;.schema</text>
                </g>

                <!-- Satellite 4 (Top-Left): Cloud Storage -->
                <g class="c-ai-sat" transform="translate(176, 192)">
                  <rect x="-66" y="-22" width="132" height="44" rx="12" />
                  <text class="c-ai-sat-title" x="0" y="-3" text-anchor="middle">Cloud Storage</text>
                  <text class="c-ai-sat-sub" x="0" y="12" text-anchor="middle">apps/&lt;app&gt;/&lt;dir&gt;/</text>
                </g>

                <!-- Center Hub: Cloud Run Service -->
                <g class="c-ai-hub" transform="translate(280, 280)">
                  <circle class="c-ai-hub-pulse" cx="0" cy="0" r="54" />
                  <circle class="c-ai-hub-core" cx="0" cy="0" r="46" />
                  <text class="c-ai-hub-kicker" x="0" y="-12" text-anchor="middle">CLOUD RUN</text>
                  <text class="c-ai-hub-title" x="0" y="5" text-anchor="middle">AI Service</text>
                  <text class="c-ai-hub-sub" x="0" y="20" text-anchor="middle">run-&lt;u&gt;-&lt;app&gt;</text>
                </g>

                <!-- Container footer caption -->
                <g transform="translate(280, 446)">
                  <rect class="c-ai-footer" x="-126" y="-13" width="252" height="26" rx="13" />
                  <text class="c-ai-footer-txt" x="0" y="4" text-anchor="middle">Cloud Console &amp; Antigravity IDE &middot; Usage only</text>
                </g>
              </g>
            </svg>
          </div>

          <!-- Interactive Ring Legend Bar -->
          <div class="crucible-dial-legend" aria-hidden="true">
            <button type="button" class="c-legend-item is-active" data-cstage-jump="0">
              <i class="c-leg-dot c-leg-blue"></i><span>Playground Folder</span>
            </button>
            <button type="button" class="c-legend-item" data-cstage-jump="1">
              <i class="c-leg-dot c-leg-green"></i><span>Playground Shards</span>
            </button>
            <button type="button" class="c-legend-item" data-cstage-jump="2">
              <i class="c-leg-dot c-leg-amber"></i><span>Workspace</span>
            </button>
            <button type="button" class="c-legend-item" data-cstage-jump="3">
              <i class="c-leg-dot c-leg-red"></i><span>AI App (app-lab1)</span>
            </button>
          </div>
        </div>
      </div>
    </section>
  ) : (
    <div class="hero">
      <div class="sl-flex stack">
        <div class="sl-flex copy">
          <h1 id="_top" data-page-title set:html={title} />
          {tagline && <div class="tagline" set:html={tagline} />}
        </div>
      </div>
    </div>
  )
}

<script>
  function initCrucibleLifecycle() {
    const section = document.getElementById('crucible-launch');
    if (!section || section.dataset.bound === '1') return;
    section.dataset.bound = '1';

    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('.c-stage-tab'));
    const bars = Array.from(section.querySelectorAll<HTMLElement>('.c-stage-progress'));
    const panes = Array.from(section.querySelectorAll<HTMLElement>('[data-cstage-pane]'));
    const legendBtns = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-cstage-jump]'));
    const ringTargets = Array.from(section.querySelectorAll<SVGGElement>('[data-ring-click]'));

    const dialStep = document.getElementById('c-dial-step');
    const dialStatus = document.getElementById('c-dial-status');
    const sumKicker = document.getElementById('c-summary-kicker');
    const sumMain = document.getElementById('c-summary-main');
    const sumSub = document.getElementById('c-summary-sub');

    const STAGE_META = [
      {
        step: '01 / 04 · IT ADMIN',
        status: 'Catalogs & Playground Folder Governance',
        kicker: 'GOVERNED',
        main: 'Folder',
        sub: 'IT Admin',
      },
      {
        step: '02 / 04 · BU ADMIN',
        status: 'Pinned Template & Project Shards',
        kicker: 'SHARDED',
        main: 'Playground',
        sub: 'BU Admin',
      },
      {
        step: '03 / 04 · STUDENT / USER',
        status: 'Singletons & App Containers (min..max)',
        kicker: 'ISOLATED',
        main: 'Workspace',
        sub: 'Student / User',
      },
      {
        step: '04 / 04 · AI PLAYGROUND TEMPLATE',
        status: 'Running AI App Inside app-lab1',
        kicker: 'ACTIVE',
        main: 'app-lab1',
        sub: 'sa-<user>',
      },
    ];

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const STAGE_MS = 3500;

    let activeStage = 0;
    let stageStart = performance.now();
    let pausedUntil = 0;
    let isHovered = false;

    function applyStage(idx: number, userTriggered: boolean) {
      const next = ((idx % 4) + 4) % 4;
      activeStage = next;
      stageStart = performance.now();
      if (userTriggered) pausedUntil = stageStart + 7000;

      section!.dataset.activeStage = String(next);

      tabs.forEach((tab, i) => {
        const on = i === next;
        tab.classList.toggle('is-active', on);
        tab.classList.toggle('is-done', i < next);
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
      });

      bars.forEach((bar, i) => {
        if (i < next) {
          bar.style.transform = 'scaleX(1)';
        } else if (i > next) {
          bar.style.transform = 'scaleX(0)';
        } else {
          bar.style.transform = reduceMotion ? 'scaleX(1)' : 'scaleX(0)';
        }
      });

      panes.forEach((p, i) => p.classList.toggle('is-active', i === next));
      legendBtns.forEach((b, i) => b.classList.toggle('is-active', i === next));

      const meta = STAGE_META[next];
      if (dialStep) dialStep.textContent = meta.step;
      if (dialStatus) dialStatus.textContent = meta.status;
      if (sumKicker) sumKicker.textContent = meta.kicker;
      if (sumMain) sumMain.textContent = meta.main;
      if (sumSub) sumSub.textContent = meta.sub;
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => applyStage(i, true)));
    legendBtns.forEach((btn) => {
      const idx = Number(btn.dataset.cstageJump || '0');
      btn.addEventListener('click', () => applyStage(idx, true));
    });
    ringTargets.forEach((g) => {
      const idx = Number(g.dataset.ringClick || '0');
      g.addEventListener('click', () => applyStage(idx, true));
    });

    const dialWrap = section.querySelector('.crucible-dial-wrap');
    dialWrap?.addEventListener('pointerenter', () => {
      isHovered = true;
    });
    dialWrap?.addEventListener('pointerleave', () => {
      isHovered = false;
      stageStart = performance.now();
    });

    applyStage(0, false);

    if (!reduceMotion) {
      let rafId = 0;
      function tick(now: number) {
        if (!document.body.contains(section)) {
          cancelAnimationFrame(rafId);
          return;
        }
        if (isHovered || now < pausedUntil) {
          bars[activeStage].style.transform = 'scaleX(1)';
        } else {
          const elapsed = now - stageStart;
          const progress = Math.min(1, Math.max(0, elapsed / STAGE_MS));
          bars[activeStage].style.transform = `scaleX(${progress.toFixed(3)})`;
          if (elapsed >= STAGE_MS) {
            applyStage(activeStage + 1, false);
          }
        }
        rafId = requestAnimationFrame(tick);
      }
      rafId = requestAnimationFrame(tick);
    }
  }

  initCrucibleLifecycle();
  document.addEventListener('astro:page-load', initCrucibleLifecycle);
</script>
