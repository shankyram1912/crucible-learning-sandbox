# ManualGround: Multi-Tenant Shared Playground Shard Settings (80-Student Ceiling)
# Copy to initialize.env and fill in values:  cp initialize.env.example initialize.env
# Every key is also exported to Terraform as a lowercase TF_VAR_ copy (e.g. ORG_ID -> TF_VAR_org_id).

# ---- admin & organization settings ----

# Project that gcloud/Terraform/REST API calls are billed and rate-limited against.
# Must have Resource Manager, Service Usage, Cloud Billing, IAM, and Cloud Storage APIs enabled.
QUOTA_PROJECT=

# Organization and Workspace directory identity
ORG_ID=
DIRECTORY_CUSTOMER_ID=
DOMAIN=

# Billing account linked to the shard project (caller needs Billing User on it)
BILLING_ACCOUNT_ID=

# Groups & optional dedicated Layer 1/Layer 2 automation service account
# IT_ADMINS_GROUP and PROVISIONER_SA_EMAIL are exempted from Folder IAM Deny v2 guardrails.
IT_ADMINS_GROUP=grp-lsb-it-admins@${DOMAIN}
STUDENT_GROUP_EMAIL=grp-ntu-shard-01-students@${DOMAIN}
PROVISIONER_SA_EMAIL=

# ---- folder & shard project settings ----

# Parent under which the Playground guardrail folder is created (must be ACTIVE):
#   organizations/<ORG_ID>  = directly under the organization
#   folders/<FOLDER_ID>     = inside an existing folder, e.g. folders/600433119916
MG_PARENT_FOLDER=organizations/${ORG_ID}
MG_FOLDER_NAME="NTU Playground"
# Empty = create MG_FOLDER_NAME under MG_PARENT_FOLDER. Set = reuse existing folder ID.
MG_FOLDER_ID=

# Shared Playground shard project (globally unique across GCP; hosts up to 80 students).
# ORG_SUFFIX is computed by initialize.sh: first 3 hex chars of sha256(ORG_ID).
MG_PROJECT_ID=ntu-play-shard-01-${ORG_SUFFIX}
MG_PROJECT_NUMBER=
REGION=asia-southeast1

# Optional remote GCS bucket for Terraform state and runner status backups (created in 02-shard-project-baseline).
# Leave empty to keep Terraform state locally under state/tf/.
TF_STATE_BUCKET=${MG_PROJECT_ID}-tfstate

# ---- workload & service toggles ----

# Preset profile for shared infrastructure sizing: "dev" (zonal, lower cost) or "prod" (HA regional, 800 max_connections)
MG_PRESET=dev

# Toggle Shared Cloud SQL for PostgreSQL 16 (04-shared-cloud-sql & Layer 2 sql driver): true or false
ENABLE_CLOUD_SQL=true
MG_SQL_INSTANCE=sql-${MG_PROJECT_ID}

# Maximum on-demand Cloud Run services each student may own concurrently (enforced by ntu-run-auto-owner)
MAX_SERVICES_PER_STUDENT=3

# ---- billing attribution labels ----
# Every LABEL_<NAME> key becomes label <name> (lowercase, "_" -> "-") on the shard project.
LABEL_COST_CENTER_BU=school-computing
LABEL_COST_CENTER_CODE=ntu-cs
LABEL_COST_CATEGORY=learning-sandbox
LABEL_BU_TRACKING_CODE=ntu-100-001
LABEL_BU_SUBCATEGORY=ntu-manualground

# ---- generated by terraform/run.sh (do not edit) ----
